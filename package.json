{
  "name": "mc-monorepo",
  "version": "1.0.0",
  "description": "Monorepo for MC Project (Frontend, Backend, shared data and contracts)",
  "private": true,
  "workspaces": [
    "packages/front/*",
    "packages/back/*",
    "packages/core/*"
  ],
  "type": "module",
  "scripts": {
    "install-all": "npm install",
    "start:all": "node scripts/start-all.js docker",
    "start:all:local": "node scripts/start-all.js local",
    "start:all:docker": "node scripts/start-all.js docker",
    "start:frontend": "npm run serve --workspace=packages/front/mc-frontend",
    "start:mc-users": "npm run serve --workspace=packages/front/mc-users",
    "start:mc-match": "npm run serve --workspace=packages/front/mc-match",
    "start:mc-deck": "npm run serve --workspace=packages/front/mc-deck",
    "start:mc-static": "npm run serve --workspace=packages/front/mc-static",
    "start:match-creation": "node packages/back/mc-match-creation-service/index.js",
    "start:mc-deck-service": "npm run start --workspace=packages/back/mc-deck-service",
    "start:mc-user-service": "npm run start --workspace=packages/back/mc-user-service",
    "https:setup": "node scripts/setup-dev-https.js",
    "maildev": "maildev --ip 127.0.0.1 --web-ip 127.0.0.1 --smtp 1025 --web 8025",
    "prestart:backend": "npm run seed:data",
    "start:backend": "npx nodemon packages/back/mc-back/index.js",
    "test": "npm test --workspace=packages/back/mc-back",
    "test:frontend": "npm test --workspace=packages/front/mc-frontend",
    "test:mc-users": "npm test --workspace=packages/front/mc-users",
    "test:mc-user-service": "npm test --workspace=packages/back/mc-user-service",
    "test:match-creation": "npm test --workspace=packages/back/mc-match-creation-service",
    "mongo:up": "docker-compose up -d mongodb",
    "mongo:down": "docker-compose stop mongodb",
    "mailpit:up": "docker-compose up -d mailpit",
    "mailpit:down": "docker-compose stop mailpit",
    "seed:data": "npm run seed --workspace=packages/back/mc-data",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.11.0",
    "eslint": "^9.11.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "maildev": "^3.0.0",
    "nodemon": "^3.1.14"
  }
}
