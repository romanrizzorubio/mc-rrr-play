# Local directo (sin Docker)
PUBLIC_IP=localhost
PROTOCOL=http
USE_PORTS_IN_URL=true
USE_HTTPS=false
PORT_GATEWAY=80
PORT_FRONTEND=8000
SESSION_COOKIE_SECURE=false
FRONTEND_ORIGIN=http://localhost:8000

