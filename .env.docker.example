# Docker local con acceso por puertos directos del host (no usa mc-gateway desde el navegador).
PUBLIC_IP=localhost
PROTOCOL=http
USE_PORTS_IN_URL=true
USE_HTTPS=false
PORT_GATEWAY=80
PORT_FRONTEND=8000
SESSION_COOKIE_SECURE=false

# SMTP local: Mailpit captura los mensajes y no los entrega a destinatarios reales.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="no-reply@mc-rrr.com<romanrizzorubio@gmail.com>"

# Para enviar por un proveedor real, sustituye estos valores por sus datos SMTP.
