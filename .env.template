# Configuración pública
# En Docker local, usa 127.0.0.1 para evitar el 502 por auto-proxy del gateway.
PUBLIC_IP=localhost
PROTOCOL=http
USE_PORTS_IN_URL=false

# Configuración de red (Docker)
PORT_GATEWAY=80
PORT_FRONTEND=8000

# Seguridad y Protocolo interno
USE_HTTPS=false
SESSION_COOKIE_SECURE=false

# Ejemplos por entorno:
# Local: PUBLIC_IP=localhost, USE_PORTS_IN_URL=true
# Docker local: PUBLIC_IP=127.0.0.1, USE_PORTS_IN_URL=false
# AWS: PUBLIC_IP=tu-dominio.com, PROTOCOL=https, USE_PORTS_IN_URL=false
