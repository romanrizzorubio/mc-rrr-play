# AWS / producción (con Nginx como gateway)
PUBLIC_IP=mc-rrr.com
PROTOCOL=https
USE_PORTS_IN_URL=false
FRONTEND_ORIGIN=https://mc-rrr.com
USE_HTTPS=false
PORT_GATEWAY=80
PORT_FRONTEND=8000
SESSION_COOKIE_SECURE=true

# Sustituye los placeholders por credenciales SMTP válidas antes del despliegue.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=REPLACE_WITH_BREVO_SMTP_LOGIN
SMTP_PASSWORD=REPLACE_WITH_BREVO_SMTP_KEY
SMTP_FROM="MC RRR Play <no-reply@mc-rrr.com>"
